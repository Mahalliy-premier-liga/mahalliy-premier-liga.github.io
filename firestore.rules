rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Faqat shu emailga ega tashkilotchi yoza oladi (bir nechta bolsa, vergul bilan qoshing)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['suyunbeksafaraliyev@gmail.com'];
    }

    // Liga malumoti: hamma oqiy oladi, faqat tashkilotchi yozadi
    match /league/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tashrifchilar hisoblagichi: hamma oqiy oladi va faqat 1 taga oshira oladi
    match /stats/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    // Logotip va rasmlar
    match /images/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.d.size() < 950000;
      allow delete: if isAdmin();
    }
  }
}
